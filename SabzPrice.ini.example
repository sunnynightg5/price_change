; این فایل را به SabzPrice.ini تغییر نام دهید و کنار Project1.exe قرار دهید.
; همه کلیدها اختیاری هستند؛ در صورت نبودن، مقدار پیش‌فرض استفاده می‌شود.

[Excel]
; مسیر فایل اکسل قیمت. اگر پیدا نشود برنامه خودش می‌پرسد و اینجا ذخیره می‌کند.
Path=F:\Program sabz\Price.xls

[Database]
; رشته اتصال ADO (پیش‌فرض: SQL Server محلی، پایگاه داده SABZ با Windows Authentication)
;ConnectionString=Provider=SQLOLEDB.1;Integrated Security=SSPI;Persist Security Info=False;Initial Catalog=SABZ;Data Source=.

[PrintShop]
; نام و مشخصات چاپخانه؛ با تیک «فاکتور با نام چاپخانه» روی فاکتور A5 می‌آید.
Name=چاپخانه نمونه
Phone=۰۹۱۲۳۴۵۶۷۸۹
Address=تهران، خیابان نمونه، پلاک ۱۲

[Studio]
; مشخصات استودیو که در فاکتور عکاسی نمایش داده می‌شود (همه اختیاری).
Name=استودیو عکاسی سبز
Phone=۰۹۱۲۳۴۵۶۷۸۹
Address=شیراز، ...
Instagram=@sabz.studio
;Email=info@example.com
;Website=www.example.com
;EconomicCode=411234567890
;RegisterNo=12345

[Payment]
; فقط نام بانک روی فاکتور می‌آید (بدون شماره کارت و صاحب حساب).
;Bank=ملت

[Invoice]
; مسیر لوگوی استودیو. اگر خالی باشد، فایل logo.png کنار Project1.exe استفاده می‌شود.
; لوگو فقط روی فاکتور عکاسی می‌آید، نه فاکتور چاپخانه.
;Logo=C:\path\to\logo.png
; مالیات بر ارزش افزوده با تیک «مالیات بر ارزش افزوده ۱۰٪» در صفحه محاسبه سفارش اعمال می‌شود.
